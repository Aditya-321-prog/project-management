PORT=8000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Deploy par "production" karna (cookies cross-site ke liye)
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

ACCESS_TOKEN_SECRET=<random-64-char-string>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<another-random-64-char-string>
REFRESH_TOKEN_EXPIRY=10d

GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

GMAIL_USER=<your-gmail>@gmail.com
GMAIL_APP_PASSWORD=<16-char-app-password>
