PORT=8000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Deploy par "production" karna (cookies cross-site ke liye)
NODE_ENV=development

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

ACCESS_TOKEN_SECRET=<random-64-char-string>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<another-random-64-char-string>
REFRESH_TOKEN_EXPIRY=10d

GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com

GMAIL_USER=<your-gmail>@gmail.com
GMAIL_APP_PASSWORD=<16-char-app-password>

# ===== Deadline reminders =====
# Roz kab chale (cron format). Default: subah 9 baje
REMINDER_CRON=0 9 * * *
REMINDER_TIMEZONE=Asia/Kolkata
# Band karna ho to false
REMINDERS_ENABLED=true
# Production me /api/v1/reminders/run allow karna ho to true
REMINDERS_ALLOW_MANUAL=false

# ===== Cloudinary (file uploads) =====
# Teeno set ho to files Cloudinary par jaati hain, warna local public/ folder me
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Cloudinary me kis folder me (optional)
CLOUDINARY_FOLDER=task-manager
